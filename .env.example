# ============================================================================
# some-stripe Web Framework Examples & Integration Tests Configuration (.env)
# Copy this file to `.env` (or `.env.local` / `.env.dev`) and set your keys:
#   cp .env.example .env
#
# All Axum and Actix-Web examples and integration tests use native `$VAR_NAME`
# resolution (`StripeClient::new("$STRIPE_SECRET_KEY")` and
# `SecretKey::new("$STRIPE_WEBHOOK_SECRET")`), which automatically loads
# values from process env, `.env.local`, `.env.dev`, `.env`, or `.env.example`.
# ============================================================================

# Required: Your Stripe API Secret Key (loaded automatically by all examples & integration tests)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Optional: Webhook signing secret for Module 2 / V2 thin event signature verification
STRIPE_WEBHOOK_SECRET=whsec_test_replace_with_your_webhook_secret

# Optional: Set to 1 to also execute live end-to-end probes against https://api.stripe.com
# in addition to the deterministic wire-mock Axum & Actix-Web integration test scenarios
STRIPE_RUN_LIVE_TESTS=0

# Optional: HTTP port for the unified Axum server (default: 3000)
PORT=3000
