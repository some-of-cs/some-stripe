# Stripe Secret Key (Live or Test mode - e.g., sk_test_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Signing Secret (e.g., whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Optional: Custom API Base URL (defaults to https://api.stripe.com)
# STRIPE_API_BASE=https://api.stripe.com

# Optional: Default Redirect URLs for Hosted Checkout & Billing Portal
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/checkout/success
STRIPE_CANCEL_URL=http://127.0.0.1:8000/checkout/cancel
